}

script ColdStorageTest_EventScript_Grunt4 {
    trainerbattle_single(TRAINER_COLD_STORAGE_GRUNT_4, ColdStorageTest_Text_Grunt4Intro, ColdStorageTest_Text_Grunt4Defeat)
    msgbox(format("That console runs the coolant for the centre aisle. Don't touch it! …Ugh, why did I say that."), MSGBOX_AUTOCLOSE)
