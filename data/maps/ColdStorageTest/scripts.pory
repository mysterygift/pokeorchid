    format("Hey! This warehouse is closed for… stocktaking. Scram!")
}

text ColdStorageTest_Text_Grunt1Defeat {
    format("Brr… My Pok\emon are too cold to fight.")
}

text ColdStorageTest_Text_Grunt2Intro {
    format("You slid all the way in here? Then I'll send you sliding right back out!")
}

text ColdStorageTest_Text_Grunt2Defeat {
    format("I slipped up…")
}

text ColdStorageTest_Text_Grunt3Intro {
    format("Nothing to see in this corner! Certainly nothing I lost!")
}

text ColdStorageTest_Text_Grunt3Defeat {
    format("Frozen solid…")
}

text ColdStorageTest_Text_Grunt4Intro {
    format("Halt! Nobody goes near the coolant console!")
}

text ColdStorageTest_Text_Grunt4Defeat {
    format("You've put me on ice…")
}

// ---------------------------------------------------------------- Haru + the multi battle

script ColdStorageTest_EventScript_BossTrigger {
    lockall
    playse(SE_PIN)
    applymovement(LOCALID_COLD_STORAGE_HARU, moves(face_down, emote_exclamation_mark, delay_16 * 3))
    waitmovement(0)
    msgbox(format("Haru: {PLAYER}! You found a way in too!\pThese two are packing Pok\emon into freezer containers to ship them out of Tosa. I can't stop them alone!"))
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_up * 2))
    applymovement(LOCALID_COLD_STORAGE_HARU, moves(delay_16 * 2, face_up))
    waitmovement(0)
    msgbox(format("Shelly: Boss, another brat got past the gate."))
    msgbox(format("Archie: …Two children. How tiresome.\pThis cargo leaves on tonight's tide. Stand aside, or be put on ice with it."))
    msgbox(format("Haru: Two of them, two of us. Battle with me, {PLAYER}!"))
    closemessage
    goto(ColdStorageTest_EventScript_ChoosePartyForMultiBattle)
}

raw `
ColdStorageTest_EventScript_ChoosePartyForMultiBattle::
	special SavePlayerParty
	fadescreen FADE_TO_BLACK
	special ChooseHalfPartyForBattle
	goto_if_ne VAR_RESULT, 0, ColdStorageTest_EventScript_DoMultiBattle
	special LoadPlayerParty
	msgbox ColdStorageTest_Text_HaruNoBackingOut, MSGBOX_DEFAULT
	closemessage
	goto ColdStorageTest_EventScript_ChoosePartyForMultiBattle

ColdStorageTest_EventScript_DoMultiBattle::
	multi_2_vs_2 TRAINER_COLD_STORAGE_LEADER, ColdStorageTest_Text_LeaderDefeat, TRAINER_COLD_STORAGE_ADMIN, ColdStorageTest_Text_AdminDefeat, PARTNER_HARU
	switch VAR_RESULT
	case 1, ColdStorageTest_EventScript_WonMultiBattle
	fadescreen FADE_TO_BLACK
	special SetCB2WhiteOut
	waitstate
	end
`

script ColdStorageTest_EventScript_WonMultiBattle {
    msgbox(format("Archie: …Hmph. A cold reception indeed.\pKeep the cargo, children. There are other ports."))
    closemessage
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_COLD_STORAGE_LEADER)
    removeobject(LOCALID_COLD_STORAGE_ADMIN)
    setflag(FLAG_HIDE_COLD_STORAGE_VILLAINS)
    // the grunts clear out with them (removeobject only matters for one that is on screen)
    removeobject(LOCALID_COLD_STORAGE_GRUNT_1)
    removeobject(LOCALID_COLD_STORAGE_GRUNT_2)
    removeobject(LOCALID_COLD_STORAGE_GRUNT_3)
    removeobject(LOCALID_COLD_STORAGE_GRUNT_4)
    setflag(FLAG_HIDE_COLD_STORAGE_GRUNTS)
    setvar(VAR_COLD_STORAGE_STATE, 1)
    fadescreen(FADE_FROM_BLACK)
    applymovement(LOCALID_COLD_STORAGE_HARU, moves(face_left))
    waitmovement(0)
    msgbox(format("Haru: We did it! We make a pretty good team, {PLAYER}.\pI'll get these containers open. Let's warm everybody up."))
    special(HealPlayerParty)
    releaseall
    end
}

script ColdStorageTest_EventScript_Haru {
    lock
    faceplayer
    if (var(VAR_COLD_STORAGE_STATE) == 0) {
        msgbox(format("Haru: Careful, {PLAYER}! They're right there!"))
    } else {
        msgbox(format("Haru: I'll look after the Pok\emon here. Thanks for the help, {PLAYER}!"))
    }
    release
    end
}

script ColdStorageTest_EventScript_Leader {
    msgbox(format("Archie: …"), MSGBOX_NPC)
    end
}

script ColdStorageTest_EventScript_Admin {
    msgbox(format("Shelly: Hands off the cargo!"), MSGBOX_NPC)
    end
}

text ColdStorageTest_Text_HaruNoBackingOut {
    format("Haru: We can't back out now, {PLAYER}! Pick your Pok\emon!")
}

text ColdStorageTest_Text_LeaderDefeat {
    format("…So the ice cracks.")
}

text ColdStorageTest_Text_AdminDefeat {
    format("B-boss! These kids are tougher than they look!")
}
