raw `
TimahCity_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, TimahCity_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, TimahCity_OnFrame
	.byte 0

@ Orchid: Professor Palm calls once the first badge is won (VAR_ORCHID_RESEARCH 0 locked, 1 call pending,
@ 2 research unlocked - include/research.h). Arming it here too covers saves that already have the badge.
TimahCity_OnTransition:
	setflag FLAG_VISITED_PETALBURG_CITY
	goto_if_unset FLAG_BADGE01_GET, TimahCity_OnTransition_End
	goto_if_ne VAR_ORCHID_RESEARCH, 0, TimahCity_OnTransition_End
	setvar VAR_ORCHID_RESEARCH, 1
TimahCity_OnTransition_End:
	end

TimahCity_OnFrame:
	map_script_2 VAR_ORCHID_RESEARCH, 1, TimahCity_EventScript_PalmCall
	.2byte 0
`

script TimahCity_EventScript_PalmCall {
    lockall
    playse(SE_POKENAV_CALL)
    waitse
    pokenavcall(TimahCity_Text_PalmCall)
    waitmessage
    closemessage
    setvar(VAR_ORCHID_RESEARCH, 2)
    msgbox(format("Bzzt! Palm's Research is now in the QUESTS app!"), MSGBOX_ROTOM)
    releaseall
}

text TimahCity_Text_PalmCall {
    format("PALM: {PLAYER}! Professor Palm here. Word travels fast: you beat Hana! Congratulations!\pNow that you've proven yourself, I'd like your help with my research.\pCatalogue the Pokémon of each habitat, by day and by night. Catch each species twice so we can record everything about it.\pI've sent my field notes to your Rotom Phone. Look for Research in the QUESTS app!", 168)
}

script TimahCity_EventScript_TownSign {
    msgbox(format("Timah City\n“The green heart of the Tosa Reserve.”"), MSGBOX_SIGN)
}

script TimahCity_EventScript_GymSign {
    msgbox(format("Timah City Pokémon Gym\nLeader: Hana. Grass-type Pokémon."), MSGBOX_SIGN)
}

script TimahCity_EventScript_Npc1 {
    msgbox(format("Hana grows orchids in her garden that bloom nowhere else in the world. She guards them better than her Gym Badge!"), MSGBOX_NPC)
}

script TimahCity_EventScript_Npc2 {
    msgbox(format("Timah sits right in the middle of the Tosa Reserve. Stick to the paths. The Rangers are watching for poachers."), MSGBOX_NPC)
}

script TimahCity_EventScript_Npc3 {
    msgbox(format("It rains here every afternoon, like clockwork. Bring an umbrella. Or a Lotad."), MSGBOX_NPC)
}

script TimahCity_EventScript_Npc4 {
    msgbox(format("This city grew up around the old rubber trees on the hill. Now look at it: trains, Pokémon Centres…"), MSGBOX_NPC)
}

script TimahCity_EventScript_Npc5 {
    msgbox(format("There are Pokémon up in the canopy that never come down to the ground. I've been waiting all week!"), MSGBOX_NPC)
}
