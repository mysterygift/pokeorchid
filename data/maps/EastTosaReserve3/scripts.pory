mapscripts EastTosaReserve3_MapScripts {}


script EastTosaReserve3_EventScript_Sign {
    msgbox(format("East Tosa Reserve\nEast: Senoko City"), MSGBOX_SIGN)
}

script EastTosaReserve3_EventScript_Npc1 {
    msgbox(format("On a clear day you can see Senoko's wind turbines from here. Mo keeps the whole region running."), MSGBOX_NPC)
}

script EastTosaReserve3_EventScript_Npc2 {
    msgbox(format("I'm walking the whole reserve, end to end. Bura City to Senoko City! My feet hate me."), MSGBOX_NPC)
}
