mapscripts InkaCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_VISITED_RUSTBORO_CITY)
    }
}

script InkaCity_EventScript_TownSign {
    msgbox(format("Inka City\n“Tosa's logistics hub.”"), MSGBOX_SIGN)
}

script InkaCity_EventScript_GymSign {
    msgbox(format("Inka City Pokémon Gym\nLeader: Frea. Ice-type Pokémon."), MSGBOX_SIGN)
}

script InkaCity_EventScript_Sign3 {
    msgbox(format("INKA COLD DISTRIBUTION CENTRE\nManaged by Frea. Staff only."), MSGBOX_SIGN)
}

script InkaCity_EventScript_Sign4 {
    msgbox(format("MARLIN CO. SHIPPING\nAuthorised personnel only."), MSGBOX_SIGN)
}

script InkaCity_EventScript_Npc1 {
    msgbox(format("Every crate of imported food in Tosa passes through Inka. Frea makes sure it's all kept cold and on time."), MSGBOX_NPC)
}

script InkaCity_EventScript_Npc2 {
    msgbox(format("Marlin Co.? Shipping company. Keeps odd hours.\pTheir trucks come and go at night with the lights off."), MSGBOX_NPC)
}

script InkaCity_EventScript_Npc3 {
    msgbox(format("Frea runs the cold store and the Gym. I've never once seen her without a clipboard."), MSGBOX_NPC)
}

script InkaCity_EventScript_Npc4 {
    msgbox(format("The warehouses never sleep. Forklifts at three in the morning, Ice types cooling the containers… It's noisy!"), MSGBOX_NPC)
}

script InkaCity_EventScript_Npc5 {
    msgbox(format("I tried to peek inside Marlin Co. A man in a blue bandana told me to scram!"), MSGBOX_NPC)
}
