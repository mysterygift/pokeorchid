// A Scale to Remember (QUEST_HEART_SCALE): the old man proposed with a Heart Scale. There is a
// hidden one on the South Tosa Reserve riverbank (FLAG_HIDDEN_ITEM_SOUTH_TOSA_RESERVE_HEART_SCALE).
script TosaPort_OldMan {
	lock
	questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_HEART_SCALE)
	if (var(VAR_RESULT)) {
		msgbox(format("Fu-fu-fu… I asked her again, and she said yes again. Some things never change."))
		release
		end
	}
	questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_HEART_SCALE)
	if (var(VAR_RESULT)) {
		checkitem(ITEM_HEART_SCALE)
		if (var(VAR_RESULT)) {
			goto(TosaPort_OldMan_ShowHeartScale)
		}
		faceplayer
		msgbox(format("(Psst… When I was young, Heart Scales used to wash up on the riverbanks of the reserve, just north of here.)"))
		release
		end
	}
	msgbox("Fu-fu-fu...I met my wife at this very\n"
	"spot 10 years ago.")
	faceplayer
	msgbox(format("(Psst… I proposed to her right here, with a Heart Scale. I lost it years ago.)"))
	msgbox(format("(I'd love to see one again… Fu-fu…)"))
	startquest(QUEST_HEART_SCALE)
	checkitem(ITEM_HEART_SCALE)
	if (var(VAR_RESULT)) {
		goto(TosaPort_OldMan_ShowHeartScale)
	}
	release
	end
}

script TosaPort_OldMan_ShowHeartScale {
	faceplayer
	msgbox(format("Wh-what's that? A Heart Scale?! Could I… borrow it? There's something I'd like to do."), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Fu-fu… I understand. It's a precious thing."))
		release
		end
	}
	checkitemspace(ITEM_SOOTHE_BELL)
	if (!var(VAR_RESULT)) {
		msgbox(format("Hm? Your Bag looks awfully full, young one. Come back once you've made a little room."))
		release
		end
	}
	removeitem(ITEM_HEART_SCALE)
	msgbox(format("{PLAYER} handed over the Heart Scale."))
	closemessage
	applymovement(LOCALID_TOSA_PORT_OLD_MAN, moves(face_right))
	applymovement(LOCALID_TOSA_PORT_OLD_WOMAN, moves(face_left))
	waitmovement(0)
	msgbox(format("Dear… do you remember this? Will you marry me… again?"))
	closemessage
	applymovement(LOCALID_TOSA_PORT_OLD_WOMAN, moves(emote_heart))
	waitmovement(0)
	msgbox(format("Ha-ha-ha! You old romantic… Of course I will!"))
	closemessage
	applymovement(LOCALID_TOSA_PORT_OLD_WOMAN, moves(face_player))
	waitmovement(0)
	msgbox(format("Thank you, dearie. Please, take this. It was a gift for our Pokémon we received on our wedding day. I hope it brings you and your Pokémon as much joy as it did for us."))
	giveitem(ITEM_SOOTHE_BELL)
	completequest(QUEST_HEART_SCALE)
	applymovement(LOCALID_TOSA_PORT_OLD_MAN, moves(face_down))
	applymovement(LOCALID_TOSA_PORT_OLD_WOMAN, moves(face_down))
	waitmovement(0)
	release
	end
}

script TosaPort_OldWoman {
	lock
	questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_HEART_SCALE)
	if (var(VAR_RESULT)) {
		msgbox(format("Ha-ha-ha… he proposed again! At our age! Life is too short, dearie."))
		release
		end
	}
	msgbox("Ha-ha-ha...we were so reckless back\n"
	"then...life is too short...")
	release
	end
}

