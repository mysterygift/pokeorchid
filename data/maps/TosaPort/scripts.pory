}

script TosaPort_VigorothCry {
	lock
	playmoncry(SPECIES_VIGOROTH, CRY_MODE_NORMAL)
	msgbox("Vigoroth: Urraw!")
	waitmoncry
	release
	end
}

script TosaPort_ChefStall {
	lock
	faceplayer
	if(!flag(FLAG_CHEF_STALL_MET)) {
		msgbox("Bonjour!\p"
	"I have travelled many miles from my\n"
	"home in Kalos...mais alors I have grown\l"
	"tired.\p"
	"I decided that it was time to share my\n"
	"love for la cuisine du monde avec the\l"
	"people!\p"
	"Have a look at my goods, see they are\n"
	"the most fresh, non?")
	setflag(FLAG_CHEF_STALL_MET)
	call(TosaPort_ChefStall_GateauHint)
	pokemart(ChefStallGoods)
	msgbox("See you again, mon ami!")
	release
	end
	}
	msgbox("Good to see you mon ami!\n"
	"What can I get for you?")
	call(TosaPort_ChefStall_GateauHint)
	pokemart(ChefStallGoods)
	msgbox("Always a pleasure, mon ami!")
	release
	end
}

// A Taste of Home (QUEST_TASTE_OF_HOME): the Kalos artist in the Changu City Café wants an Old Gateau.
// While the quest is active the chef gives one Old Gateau for free (once).
script TosaPort_ChefStall_GateauHint {
	questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_TASTE_OF_HOME)
	if (var(VAR_RESULT) && !flag(FLAG_RECEIVED_CHEF_OLD_GATEAU)) {
		msgbox(format("Quoi? Someone from Kalos is missing home? Bien sûr, they only need a taste of my delicious gateau! Bring this to ton ami, mon ami."))
		giveitem(ITEM_OLD_GATEAU)
		if (var(VAR_RESULT)) {
			setflag(FLAG_RECEIVED_CHEF_OLD_GATEAU)
		}
	}
	return
}

mart ChefStallGoods{
	ITEM_LAVA_COOKIE
	ITEM_PEWTER_CRUNCHIES
	ITEM_OLD_GATEAU
	ITEM_BIG_MALASADA
	ITEM_SHALOUR_SABLE
}

// Flat Batteries (QUEST_PSP_BATTERIES): step 1 = the dad at the chef's stall hands over a
// Cell Battery, step 2 = bring it back here; the kid takes it for his GBA.
script TosaPort_PSPKid {
	lock
	faceplayer
	questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_PSP_BATTERIES)
	if (var(VAR_RESULT)) {
		msgbox(format("I've been helping my Dad sell fruit we import from Hoenn."))
		release
		end
	}
	questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_PSP_BATTERIES)
	if (var(VAR_RESULT)) {
		subquestmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_PSP_BATTERIES, SUB_QUEST_1)
		if (var(VAR_RESULT)) {
			msgbox(format("You found Dad? Did he give you some batteries?"))
			checkitem(ITEM_CELL_BATTERY)
			if (!var(VAR_RESULT)) {
				msgbox(format("Huh? Dad said he gave you one. Did you lose it?"))
				release
				end
			}
			removeitem(ITEM_CELL_BATTERY)
			msgbox(format("{PLAYER} handed over the Cell Battery."))
			msgbox(format("A Cell Battery? I guess that'd work!"))
			checkplayergender
			if (var(VAR_RESULT) == MALE) {
				msgbox(format("Thanks mister. Now that I've got some power again, do you fancy trading Pokémon with me? If you have a Magnemite I can trade you my Corsola."))
			} else {
				msgbox(format("Thanks miss. Now that I've got some power again, do you fancy trading Pokémon with me? If you have a Magnemite I can trade you my Corsola."))
			}
			subquestmenu(QUEST_MENU_COMPLETE_QUEST, QUEST_PSP_BATTERIES, SUB_QUEST_2)
			completequest(QUEST_PSP_BATTERIES)
			release
			end
		}
		msgbox(format("Did you find Dad yet? He said he was only getting a snack. That was ages ago…"))
		release
		end
	}
	msgbox("Ugh, Dad's making me watch his stall.\n"
	"At least he let me bring my GBA.")
	msgbox(format("…And now the batteries are flat! Dad wandered off for a snack ages ago."))
	msgbox(format("Could you find him and ask him for some batteries?"), MSGBOX_YESNO)
	if (var(VAR_RESULT) == NO) {
		msgbox(format("Ugh, adults are so lame!"))
		release
		end
	}
	msgbox(format("Thanks! Dad said he was in the mood for something sweet."))
	startquest(QUEST_PSP_BATTERIES)
	release
	end
}

script TosaPort_StallDad {
	lock
	faceplayer
	questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_PSP_BATTERIES)
	if (var(VAR_RESULT)) {
		subquestmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_PSP_BATTERIES, SUB_QUEST_1)
		if (var(VAR_RESULT)) {
			msgbox(format("Go on, take that battery to my boy. I'll be back… after one more gateau."))
			release
			end
		}
		msgbox(format("Huh? My boy sent you? He wants batteries for that game of his?"))
		msgbox(format("Hmm… All I've got is this. I picked it up at the market this morning. A battery's a battery, right?"))
		giveitem(ITEM_CELL_BATTERY)
		if (!var(VAR_RESULT)) {
			release
			end
		}
		msgbox(format("Tell him I'll be back once I've finished my Old Gateau. Or two."))
		completesubquest(QUEST_PSP_BATTERIES, SUB_QUEST_1)
		release
		end
	}
	questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_PSP_BATTERIES)
	if (var(VAR_RESULT)) {
		msgbox(format("My boy runs that fruit stall better than I do! Shh… don't tell him I said that."))
		release
		end
	}
	msgbox(format("Mmm! The Old Gateau at this stall is magnifique. Don't tell anyone you saw me here. I'm meant to be minding our fruit stall."))
	release
	end
}

