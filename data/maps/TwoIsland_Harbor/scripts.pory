mapscripts TwoIsland_Harbor_MapScripts {}

raw `
TwoIsland_Harbor_EventScript_Sailor::
	lock
	faceplayer
	message SeviiFerry_Text_WhereTo
	waitmessage
	dynmultichoice 0, 0, FALSE, 7, 0, DYN_MULTICHOICE_CB_NONE, SeviiFerry_Text_OneIsland, SeviiFerry_Text_ThreeIsland, SeviiFerry_Text_FourIsland, SeviiFerry_Text_FiveIsland, SeviiFerry_Text_SixIsland, SeviiFerry_Text_SevenIsland, SeviiFerry_Text_Stay_Option
	switch VAR_RESULT
	case 0, TwoIsland_Harbor_EventScript_ToOneIsland
	case 1, TwoIsland_Harbor_EventScript_ToThreeIsland
	case 2, TwoIsland_Harbor_EventScript_ToFourIsland
	case 3, TwoIsland_Harbor_EventScript_ToFiveIsland
	case 4, TwoIsland_Harbor_EventScript_ToSixIsland
	case 5, TwoIsland_Harbor_EventScript_ToSevenIsland
	msgbox SeviiFerry_Text_Stay, MSGBOX_DEFAULT
	release
	end

TwoIsland_Harbor_EventScript_ToOneIsland::
	setvar VAR_0x8004, LOCALID_TWO_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_TWO_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_ONE_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

TwoIsland_Harbor_EventScript_ToThreeIsland::
	setvar VAR_0x8004, LOCALID_TWO_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_TWO_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_THREE_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

TwoIsland_Harbor_EventScript_ToFourIsland::
	setvar VAR_0x8004, LOCALID_TWO_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_TWO_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_FOUR_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

