	setvar VAR_0x8004, LOCALID_TWO_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_TWO_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_FIVE_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

TwoIsland_Harbor_EventScript_ToSixIsland::
	setvar VAR_0x8004, LOCALID_TWO_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_TWO_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_SIX_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

TwoIsland_Harbor_EventScript_ToSevenIsland::
	setvar VAR_0x8004, LOCALID_TWO_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_TWO_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_SEVEN_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

`
