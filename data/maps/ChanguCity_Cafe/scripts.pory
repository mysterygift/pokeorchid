// Wavebreak Voyages: the Changu City Battle Café (placeholder for a future Battle Lounge).
// Cynthia sits at the far table once she has been beaten at Holon Lake; her script is
// Common_EventScript_CynthiaCafe (data/scripts/cynthia.pory).
mapscripts ChanguCity_Cafe_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_CYNTHIA_BEATEN_AT_LAKE)) {
            clearflag(FLAG_HIDE_CHANGU_CAFE_CYNTHIA)
        } else {
            setflag(FLAG_HIDE_CHANGU_CAFE_CYNTHIA)
        }
    }
}

script ChanguCity_Cafe_EventScript_Barista {
    msgbox(format("Welcome to the Battle Café!"), MSGBOX_NPC)
}

script ChanguCity_Cafe_EventScript_Businessman {
    msgbox(format("We flew in from Lumiose this morning. If this deal doesn't close by tonight, I'm on the red-eye home."), MSGBOX_NPC)
}

script ChanguCity_Cafe_EventScript_Businesswoman {
    msgbox(format("Synergise, innovate, leverage… I just wanted a kaya toast in peace."), MSGBOX_NPC)
}

script ChanguCity_Cafe_EventScript_Tourist {
    if (flag(FLAG_CYNTHIA_BEATEN_AT_LAKE)) {
        msgbox(format("That blonde lady in the corner has been here every day since she came back from Holon Lake. Is she someone famous?"), MSGBOX_NPC)
    } else {
        msgbox(format("They call this place the Battle Café. Trainers come here between flights, hoping a strong opponent walks in."), MSGBOX_NPC)
    }
}

// A Taste of Home (QUEST_TASTE_OF_HOME): a homesick Lumiose painter. The Old Gateau is sold by the
// Kalos chef's stall in Tosa Port (TosaPort ChefStallGoods).
script ChanguCity_Cafe_EventScript_KalosArtist {
    lock
    faceplayer
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_TASTE_OF_HOME)
    if (var(VAR_RESULT)) {
        msgbox(format("Merci encore, mon ami! I wrote to the chef in Tosa Port. Now he posts me an Old Gateau every month!"))
        release
        end
    }
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_TASTE_OF_HOME)
    if (!var(VAR_RESULT)) {
        msgbox(format("Bonjour… Pardon, I am a little homesick today."))
        msgbox(format("I came from Lumiose to paint the colours of Tosa. The light here is magnifique, but the food… it is not home."))
        msgbox(format("What I would give for a taste of home… An Old Gateau, like the ones ma grand-mère bought every Sunday."))
        startquest(QUEST_TASTE_OF_HOME)
    }
    checkitem(ITEM_OLD_GATEAU)
    if (!var(VAR_RESULT)) {
        msgbox(format("An Old Gateau, here in Tosa… It is only a dream, non?"))
        release
        end
    }
    msgbox(format("Mon dieu… that smell! Is that an Old Gateau?! Would you let me have it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        msgbox(format("Ah… I understand. It is too delicious to give away."))
        release
        end
    }
    checkitemspace(ITEM_STAR_PIECE)
    if (!var(VAR_RESULT)) {
        msgbox(format("Ah, but your Bag is full! Make a little room, and I will repay you properly."))
        release
        end
    }
    removeitem(ITEM_OLD_GATEAU)
    msgbox(format("{PLAYER} handed over the Old Gateau."))
    msgbox(format("…Mmm! Oui, c'est ça! For a moment, I was back on the boulevards of Lumiose!"))
    msgbox(format("You must take this. It is not much, but it shines like Prism Tower at night."))
    giveitem(ITEM_STAR_PIECE)
    completequest(QUEST_TASTE_OF_HOME)
    release
    end
}
