mapscripts SevenIsland_Harbor_MapScripts {}

raw `
SevenIsland_Harbor_EventScript_Sailor::
	lock
	faceplayer
	message SeviiFerry_Text_WhereTo
	waitmessage
	dynmultichoice 0, 0, FALSE, 7, 0, DYN_MULTICHOICE_CB_NONE, SeviiFerry_Text_SixIsland, SeviiFerry_Text_OneIsland, SeviiFerry_Text_TwoIsland, SeviiFerry_Text_ThreeIsland, SeviiFerry_Text_FourIsland, SeviiFerry_Text_FiveIsland, SeviiFerry_Text_Stay_Option
	switch VAR_RESULT
	case 0, SevenIsland_Harbor_EventScript_ToSixIsland
	case 1, SevenIsland_Harbor_EventScript_ToOneIsland
	case 2, SevenIsland_Harbor_EventScript_ToTwoIsland
	case 3, SevenIsland_Harbor_EventScript_ToThreeIsland
	case 4, SevenIsland_Harbor_EventScript_ToFourIsland
	case 5, SevenIsland_Harbor_EventScript_ToFiveIsland
	msgbox SeviiFerry_Text_Stay, MSGBOX_DEFAULT
	release
	end

SevenIsland_Harbor_EventScript_ToSixIsland::
	setvar VAR_0x8004, LOCALID_SEVEN_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_SEVEN_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_SIX_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

SevenIsland_Harbor_EventScript_ToOneIsland::
	setvar VAR_0x8004, LOCALID_SEVEN_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_SEVEN_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_ONE_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

