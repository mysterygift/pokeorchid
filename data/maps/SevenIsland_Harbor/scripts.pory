	setvar VAR_0x8004, LOCALID_SEVEN_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_SEVEN_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
	warp MAP_TWO_ISLAND_HARBOR, 8, 4
	waitstate
	release
	end

