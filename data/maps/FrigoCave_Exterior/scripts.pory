mapscripts FrigoCave_Exterior_MapScripts {}


script FrigoCave_Exterior_EventScript_Sign {
    msgbox(format("Frigo Cave\nA deep cave where Regice resides, off the coast of Tiksi's north shore."), MSGBOX_SIGN)
}

script FrigoCave_Exterior_EventScript_Npc1 {
    msgbox(format("The sea's gone cold out here, colder every day. Something in that cave is chilling the whole shore."), MSGBOX_NPC)
}

script FrigoCave_Exterior_EventScript_Guardian1 {
    msgbox(format("Frigo Cave is colder than it has any right to be. The ice giant is back inside.\pI have guarded this shore all my life. Don't make me regret letting you pass."), MSGBOX_NPC)
}
