mapscripts ThreeIsland_BondBridge_MapScripts {}

script ThreeIsland_BondBridge_EventScript_Nikki {
    trainerbattle_single(TRAINER_SEVII_NIKKI, ThreeIsland_BondBridge_Text_NikkiIntro, ThreeIsland_BondBridge_Text_NikkiDefeat)
    msgbox(ThreeIsland_BondBridge_Text_NikkiPost, MSGBOX_AUTOCLOSE)
}

text ThreeIsland_BondBridge_Text_NikkiIntro {
    format("Breathe in the sea breeze... then battle!")
}

text ThreeIsland_BondBridge_Text_NikkiDefeat {
    format("What a sour ending.")
}

text ThreeIsland_BondBridge_Text_NikkiPost {
    format("Each island has its own character. Have you visited them all?")
}

script ThreeIsland_BondBridge_EventScript_Violet {
    msgbox(format("The sunsets out here are something special."), MSGBOX_NPC)
}

script ThreeIsland_BondBridge_EventScript_Amira {
