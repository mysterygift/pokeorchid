raw `
TosaPort_BrendansHouse_1F_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, TosaPort_BrendansHouse_1F_OnFrame
	.byte 0

@ ON_WARP_INTO_MAP_TABLE uses RunScriptImmediately(), which stops at the first cmd that returns TRUE
@ (e.g. lockall, waitmovement). That leaves the map stuck on a black screen. ON_FRAME_TABLE uses the
@ normal field script runner after the map has faded in.
@
@ VAR_TEMP_E is 0 on map load; set to 1 before running or suppressing so this only arms once per visit.
TosaPort_BrendansHouse_1F_OnFrame:
	map_script_2 VAR_TEMP_E, 0, TosaPort_BrendansHouse_1F_EventScript_OnFrameTryRival
	.2byte 0

TosaPort_BrendansHouse_1F_EventScript_OnFrameTryRival::
	goto_if_set FLAG_HIDE_TOSA_GATEWAY_RIVAL, TosaPort_BrendansHouse_1F_EventScript_OnFrameTryRival_Suppress
	setvar VAR_TEMP_E, 1
	call TosaGateway_RivalEncounter
	end

TosaPort_BrendansHouse_1F_EventScript_OnFrameTryRival_Suppress::
	setvar VAR_TEMP_E, 1
	end
`

script TosaGateway_RivalEncounter {
    lockall
    applymovement(LOCALID_RIVAL, moves(emote_exclamation_mark walk_left walk_down * 2))
    playse(SE_PIN)
    waitmovement(0)
    msgbox(format("Hey pal. I hope you aren't looking to catch the underground, the trains are closed until further notice."))
    msgbox(format("Are you heading to Telok as well?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) != 1) {
        msgbox(format("Well I hope you like the look of this waiting room..."), MSGBOX_NPC)
    } else {
        msgbox(format("Oh cool! Are you off to visit Professor Palm? I remember studying his books on Pok\emon Migration in University...")MSGBOX_NPC)
    }
    delay(24)
    msgbox(format("Haru: I'm Haru by the way, it's a pleasure to meet you. I'm travelling the Tosa region in search of the ultimate Pok\emon."))
    msgbox(format("Haru: What's the ultimate Pok\emon?\p"))
    trainerbattle_single(TRAINER_HARU_GATEWAY, TosaGateway_Haru_Intro, TosaGateway_Haru_Defeat, TosaGateway_Haru_Defeated)
    return
}

script TosaGateway_Haru_Defeated {
    lockall
    msgbox(format("Haru: I'm sure I'll see you around, {PLAYER}. Safe travels!"), MSGBOX_NPC)
    applymovement(LOCALID_RIVAL, moves(walk_up walk_left * 2 walk_up * 7))
    waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_RIVAL, MAP_TOSA_PORT_BRENDANS_HOUSE_1F)
    setflag(FLAG_HIDE_TOSA_GATEWAY_RIVAL)
    setvar(VAR_TOSA_PORT_STATE, 3)
    releaseall
    return
}

text TosaGateway_Haru_Intro {
    "Let's find out!"
}

text TosaGateway_Haru_Defeat {
    "You floored me!"
}

script TosaGateway_Receptionist {
    lock
    faceplayer
    msgbox(format("We apologise, but the train station is currently closed for maintenance."), MSGBOX_NPC)
    release
    end
}

script TosaGateway_RailwayGuard {
    lock
    faceplayer
    msgbox(format("The train station's closed. My supervisor mentioned something about Koffing in the tunnels."), MSGBOX_NPC)
    release
    end
}

script TosaGateway_Gentleman {
    lock
    faceplayer
    msgbox(format("I've re-read this newspaper five times. Maybe I should've bought myself a Rotom Phone after all..."), MSGBOX_NPC)
    release
    end
}

script TosaGateway_Mum {
    lock
    faceplayer
    msgbox(format("We're resting up before going for a walk in the reserve."), MSGBOX_NPC)
    release
    end
}

script TosaGateway_Kid {
    lock
    faceplayer
    msgbox(format("I can't wait to catch a Mareep in the reserve! They're so fluffy!"), MSGBOX_NPC)
    release
    end
}