mapscripts SevenIsland_SevaultCanyon_Entrance_MapScripts {}

script SevenIsland_SevaultCanyon_Entrance_EventScript_Miah {
    trainerbattle_single(TRAINER_SEVII_MIAH, SevenIsland_SevaultCanyon_Entrance_Text_MiahIntro, SevenIsland_SevaultCanyon_Entrance_Text_MiahDefeat)
    msgbox(SevenIsland_SevaultCanyon_Entrance_Text_MiahPost, MSGBOX_AUTOCLOSE)
}

text SevenIsland_SevaultCanyon_Entrance_Text_MiahIntro {
    format("A sweet scent drifts through the canyon...")
}

text SevenIsland_SevaultCanyon_Entrance_Text_MiahDefeat {
    format("How bitter...")
}

text SevenIsland_SevaultCanyon_Entrance_Text_MiahPost {
    format("The sunsets out here are something special.")
}

script SevenIsland_SevaultCanyon_Entrance_EventScript_Eve {
    msgbox(format("The canyon ahead is steep. Get ready for a climb!"), MSGBOX_NPC)
}

script SevenIsland_SevaultCanyon_Entrance_EventScript_Jon {
    msgbox(format("The Sevii Islands are so peaceful. I could stay here forever."), MSGBOX_NPC)
}

script SevenIsland_SevaultCanyon_Entrance_EventScript_Nicolas {
    trainerbattle_single(TRAINER_SEVII_NICOLAS, SevenIsland_SevaultCanyon_Entrance_Text_NicolasIntro, SevenIsland_SevaultCanyon_Entrance_Text_NicolasDefeat)
    msgbox(SevenIsland_SevaultCanyon_Entrance_Text_NicolasPost, MSGBOX_AUTOCLOSE)
}

text SevenIsland_SevaultCanyon_Entrance_Text_NicolasIntro {
    format("Sevault Canyon is tough. Prove you're ready!")
}

text SevenIsland_SevaultCanyon_Entrance_Text_NicolasDefeat {
    format("You'll do fine in there.")
}

text SevenIsland_SevaultCanyon_Entrance_Text_NicolasPost {
    format("The canyon ahead is steep. Get ready for a climb!")
}

