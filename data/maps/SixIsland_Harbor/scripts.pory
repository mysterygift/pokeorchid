SixIsland_Harbor_EventScript_ToFiveIsland::
	setvar VAR_0x8004, LOCALID_SIX_ISLAND_HARBOR_BOAT
	setvar VAR_0x8005, LOCALID_SIX_ISLAND_HARBOR_SAILOR
	call SeviiFerry_EventScript_Board
