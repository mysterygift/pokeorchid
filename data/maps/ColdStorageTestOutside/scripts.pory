// A scrap of Tosa Port with the Cold Storage exterior tiles (appended to gTileset_Slateport) and the
// animated sliding door. One-way now: the door leads inside, but the interior's exit goes to the
// real building on Tosa Port.

mapscripts ColdStorageTestOutside_MapScripts {}

script ColdStorageTestOutside_EventScript_Sign {
    msgbox(format("Tosa Port Cold Storage\pKeep doors shut. Mind the ice."), MSGBOX_SIGN)
    end
}
