mapscripts OneIsland_KindleRoad_MapScripts {}

script OneIsland_KindleRoad_EventScript_Maria {
    trainerbattle_single(TRAINER_SEVII_MARIA, OneIsland_KindleRoad_Text_MariaIntro, OneIsland_KindleRoad_Text_MariaDefeat)
    msgbox(OneIsland_KindleRoad_Text_MariaPost, MSGBOX_AUTOCLOSE)
}

text OneIsland_KindleRoad_Text_MariaIntro {
    format("The sea off Kindle Road is my training pool!")
}

text OneIsland_KindleRoad_Text_MariaDefeat {
    format("I swallowed seawater...")
}

text OneIsland_KindleRoad_Text_MariaPost {
    format("The currents are gentle today. Perfect for a long swim.")
}

script OneIsland_KindleRoad_EventScript_Abigail {
