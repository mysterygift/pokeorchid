mapscripts TanobyDelta_MapScripts {}


script TanobyDelta_EventScript_Sign1 {
    msgbox(format("Tanoby Delta\nA river delta with a mysterious ruin at its centre."), MSGBOX_SIGN)
}

script TanobyDelta_EventScript_Sign2 {
    msgbox(format("An ancient stone chamber. Strange carvings cover the sealed doorway.\pIt's said the delta's ruins were built by people who came from across the sea."), MSGBOX_SIGN)
}

